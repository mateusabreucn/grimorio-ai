# ─── BANCO DE DADOS ────────────────────────────────────────────────────────────
# Use o Connection Pooler do Supabase (Dashboard → Settings → Database → Connection pooling)
# Modo recomendado: Transaction mode (port 6543)
# Caracteres especiais na senha DEVEM ser URL-encoded: % → %25, @ → %40, # → %23
DATABASE_URL="postgresql://postgres.XXXXXXXXXXX:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# ─── NEXTAUTH ──────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 40
NEXTAUTH_SECRET="seu-secret-aqui-minimo-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"

# ─── GOOGLE OAUTH ──────────────────────────────────────────────────────────────
# Crie em: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://seu-dominio.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID="seu-google-client-id"
GOOGLE_CLIENT_SECRET="seu-google-client-secret"

# ─── RAG SERVICE ───────────────────────────────────────────────────────────────
# URL do serviço FastAPI (Fase 2)
RAG_SERVICE_URL="http://localhost:8000"
# Gere com: openssl rand -base64 40
RAG_INTERNAL_SECRET="seu-rag-secret-aqui-minimo-32-caracteres"

# ─── GOOGLE AI ────────────────────────────────────────────────────────────────
# Gere em: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY="sua-api-key-aqui"

# ─── UPSTASH REDIS (Rate Limiting — opcional em dev) ──────────────────────────
# Crie em: https://console.upstash.com
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
