# ─── BANCO DE DADOS ───────────────────────────────────────────────────────────
# Connection pooler do Supabase (Transaction mode)
DATABASE_URL="postgresql://postgres.XXXXX:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"

# ─── VOYAGE AI ────────────────────────────────────────────────────────────────
# Gere em: https://dash.voyageai.com/api-keys
VOYAGE_API_KEY="sua-chave-voyage-ai"

# ─── AUTENTICAÇÃO INTERNA ─────────────────────────────────────────────────────
# Gere com: openssl rand -base64 40
RAG_INTERNAL_SECRET="seu-secret-minimo-32-caracteres"

# ─── CONFIGURAÇÃO RAG ──────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
SIMILARITY_THRESHOLD=0.3
EMBEDDING_MODEL="voyage-4"
